# OpenHands Agent Server target
# These defaults assume you are manually pointing the frontend at a backend on
# 127.0.0.1:8000. The recommended local workflow is `npm run dev`, which starts
# an isolated local backend for this checkout. Use `npm run dev:frontend` only
# when you intentionally want to point at a separately managed backend.
VITE_BACKEND_HOST="127.0.0.1:8000" # Host:port used by the Vite dev proxy
VITE_BACKEND_BASE_URL="http://127.0.0.1:8000" # Base URL used by browser-side direct requests
# To drive a containerized ACP agent-server, point this at the published port,
# e.g. VITE_BACKEND_BASE_URL="http://localhost:8010" — see examples/acp-docker/
# and docs/ACP_AGENTS.md → "Running ACP agents in a Docker container".
# VITE_SESSION_API_KEY="" # Set to the same value as backend SESSION_API_KEY or OH_SESSION_API_KEYS_0 when auth is enabled
# VITE_WORKING_DIR="/workspace/project/agent-canvas" # Base dir for per-conversation working_dirs. Each conversation's working_dir is <VITE_WORKING_DIR>/<id_hex>. Defaults to <OH_CANVAS_SAFE_STATE_DIR>/workspaces, which is the sibling of the agent server's <state_dir>/conversations/ persistence dir — both share the same <id_hex> per conversation.
# VITE_ENABLE_BROWSER_TOOLS="true" # Set to false to omit BrowserToolSet from new conversations

# Frontend dev server
VITE_FRONTEND_PORT="3001" # Port to run the frontend application
VITE_USE_TLS="false" # Use HTTPS/WSS for proxied backend connections
VITE_INSECURE_SKIP_VERIFY="false" # Skip TLS certificate verification for proxied backend requests
# VITE_BASE_PATH="/canvas" # Build/serve the SPA under a subpath. Leave unset for root-local development.

# Public PostHog client key compiled into source builds. Precompiled library
# consumers can instead pass apiKey/apiHost/uiHost to AgentServerUIProviders.
# VITE_POSTHOG_API_KEY="phc_..."
# VITE_DO_NOT_TRACK="1" # Disable all telemetry, including anonymous install counts

# Mocking / test helpers
VITE_MOCK_API="false" # Enable/disable API mocking with MSW

# `npm run dev` (scripts/dev-safe.mjs) — isolated local backend via uvx
# OH_CANVAS_SAFE_BACKEND_PORT="18000" # Port the spawned agent-server listens on
# OH_CANVAS_SAFE_VSCODE_PORT="18001" # Port forwarded to the embedded VS Code (defaults to backend port + 1)
# OH_CANVAS_SAFE_STATE_DIR="$HOME/.openhands/agent-canvas" # Where conversations and bash events are stored (tmux sockets live under /tmp)

# Agent server version selection (uvx) — listed in order of precedence (highest first)
# OH_AGENT_SERVER_LOCAL_PATH="" # Absolute path to a local software-agent-sdk checkout. Runs the local checkout via uvx with editable openhands-sdk/tools/workspace installs so source edits are picked up on restart. Highest precedence.
# OH_AGENT_SERVER_GIT_REF="" # Git commit SHA or branch name (e.g., "main", "abc1234"). Takes precedence over version.
# OH_AGENT_SERVER_VERSION="" # Specific PyPI version (e.g., "1.18.0"). Uses latest release if unset.

# Pentest MCP servers (PROJETOSIN-187 / 189) - stdio tools in services/mcp-servers/
# FINDINGS_SERVICE_URL="http://127.0.0.1:18002"
# PENTEST_SCOPE_ALLOWLIST="example.com,10.0.0.0/8" # fail-closed if empty when tools run
# PENTEST_AUTONOMY_MODE="semi_autonomous" # server-side only: manual|semi_autonomous|autonomous (never from agent tool args)
# PENTEST_MCP_ROOT="/opt/mcp-servers" # compose mounts services/mcp-servers here
# PENTEST_MCP_RECON_CMD="python /opt/mcp-servers/mcp-recon/server.py"
# PENTEST_MCP_WEBSCAN_CMD="python /opt/mcp-servers/mcp-webscan/server.py"
# PENTEST_MCP_SAST_CMD="python /opt/mcp-servers/mcp-sast/server.py"
# PENTEST_MCP_FINDINGS_CMD="python /opt/mcp-servers/mcp-findings/server.py"
# OPENHANDS_CONFIRMATION_TOKEN="" # set after UI approval for intrusive tools
# MCP_WEBSCAN_TIMEOUT_SEC="300"
# PENTEST_WORKSPACE_DIR="/workspace/project"
# -- DefectDojo one-way mirror (PROJETOSIN-189) --------------------------------
# DEFECTDOJO_API_URL=https://defectdojo.heimdallsec.example
# DEFECTDOJO_API_TOKEN=
# DEFECTDOJO_PRODUCT_TYPE_DEFAULT=Pentest
# DEFECTDOJO_VERIFY_TLS=true
# DEFECTDOJO_DRY_RUN=0

# -- All-in-one Docker pentest (PROJETOSIN-200) --------------------------------
# Required by `docker compose up` (fragments included from docker-compose.yml).
# Generate locally; never commit real values. Do not use "dev-session-key".
# SESSION_API_KEY=
# LOCAL_BACKEND_API_KEY=   # optional alias — compose copies SESSION_API_KEY if set
# FINDINGS_DB_PASSWORD=
# ENGMGR_DB_PASSWORD=
# DEFAULT_PENTEST_PROFILE=pentester
# FINDINGS_UPSTREAM=http://findings-service:8000
# ENGMGR_UPSTREAM=http://engagement-manager:8000
# FINDINGS_HOST_PORT=18002
# ENGMGR_HOST_PORT=18003

# -- Android emulator (budtmo/docker-android) ----------------------------------
# Opt-in Compose profile. Pulls several GB; first boot 1–3 min.
# noVNC :6080 (aba Emulador via /api/emulator) + ADB :5555 (mcp-mobile).
# From the host: adb connect 127.0.0.1:5555  |  open http://127.0.0.1:6080
# COMPOSE_PROFILES=android-emulator
# ANDROID_EMULATOR_IMAGE=budtmo/docker-android:emulator_13.0
# ANDROID_EMULATOR_DEVICE=Samsung Galaxy S10
# ANDROID_EMULATOR_WEB_VNC=true
# ANDROID_EMULATOR_ACCEL=false
# ANDROID_ADB_HOST_PORT=5555
# ANDROID_NOVNC_HOST_PORT=6080
# ADB_HOST=android-emulator
# ADB_PORT=5555
# PENTEST_ADB_TARGET=emulator
# EMULATOR_NOVNC_URL=http://android-emulator:6080

# -- Offensive runtimes (web / network / sast) ---------------------------------
# Opt-in Compose profile. First --build pulls ZAP + Metasploit (several GB).
# Healthz/ZAP/msfrpcd bind loopback on the host; DNS names work inside compose.
# COMPOSE_PROFILES=android-emulator,pentest-runtimes
# RUNTIME_WEB_IMAGE=heimdall/runtime-web:local
# RUNTIME_NETWORK_IMAGE=heimdall/runtime-network:local
# RUNTIME_SAST_IMAGE=heimdall/runtime-sast:local
# RUNTIME_WEB_HEALTHZ_HOST_PORT=8090
# RUNTIME_WEB_ZAP_HOST_PORT=18080
# RUNTIME_NETWORK_HEALTHZ_HOST_PORT=8091
# RUNTIME_SAST_HEALTHZ_HOST_PORT=8094
# MSF_RPC_HOST_PORT=55553
# MSF_PASSWORD=
# ZAP_URL=http://runtime-web:8080
# RUNTIME_WEB_URL=http://runtime-web:8090
# RUNTIME_NETWORK_URL=http://runtime-network:8091
# RUNTIME_SAST_URL=http://runtime-sast:8094
# MSF_RPC_HOST=runtime-network
# MSF_RPC_PORT=55553

# -- Electron desktop pentest hooks (PROJETOSIN-193) ---------------------------
# Host Docker Compose + ADB IPC via window.pentestNative. Default OFF.
# Enable only for local Electron desktop (`npm run desktop`), never for
# server/--public mode. Opt-in explicitly — not enabled "by accident" in CI.
# PENTEST_ELECTRON_HOOKS_ENABLED=true
# Example: PENTEST_ELECTRON_HOOKS_ENABLED=true npm run desktop

