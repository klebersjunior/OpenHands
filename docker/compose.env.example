# Copy to `.env` in the repo root (Compose loads it automatically), or run:
#   docker compose --env-file docker/compose.env.example up -d
#
# Do not commit real secrets.

# ?? Image / build ????????????????????????????????????????????????????????????
# Published release (default in docker-compose.yml):
# AGENT_CANVAS_IMAGE=ghcr.io/openhands/agent-canvas:1.10.0

# Local tag while iterating on this checkout:
# AGENT_CANVAS_IMAGE=agent-canvas:local

# Base agent-server image + automation pin (used only by `docker compose build`)
# AGENT_SERVER_IMAGE=ghcr.io/openhands/agent-server:1.40.1-python
# AUTOMATION_VERSION=1.6.0
# VITE_BASE_PATH=/canvas

# Optional: install agent-server Python packages from a software-agent-sdk git ref
# (useful when testing unreleased endpoints such as workspace clone).
# AGENT_SERVER_SDK_GIT_REF=main

# Path to the local @openhands/typescript-client checkout (file: dependency).
# Default assumes a sibling folder: ../typescript-client
# TYPESCRIPT_CLIENT_PATH=../typescript-client

# Path to local software-agent-sdk (POST /api/workspaces/clone and related APIs).
# Compose accepts either name; OH_AGENT_SERVER_LOCAL_PATH matches npm run dev (.env).
# SOFTWARE_AGENT_SDK_PATH=../software-agent-sdk
# OH_AGENT_SERVER_LOCAL_PATH=D:/Projetos/Heimdall/software-agent-sdk

# ?? Host networking / volumes ????????????????????????????????????????????????
# HOST_PORT=8000
# PROJECTS_PATH=./projects
# OPENHANDS_VOLUME_NAME=agent-canvas-openhands-data

# ?? Stack mode (docker/entrypoint.sh) ????????????????????????????????????????
# full (default) = agent-server + automation + SPA
# backend        = agent-server + automation + API ingress only (no SPA)
# Use docker-compose.backend-only.yml to test backend mode on :8001.
# STACK_MODE=full

# ?? Auth (optional ù auto-generated into the volume when unset) ???????????????
# LOCAL_BACKEND_API_KEY=
# OH_SECRET_KEY=
# OH_SESSION_API_KEYS_0=

# Internal UI login (username/password). Opt-in; docker-compose defaults to true.
# Default user (seeded on first start): heimdallsec / heimdallsec
# APP_LOGIN_ENABLED=true

# ?? LLM (optional ù can be set in the UI instead) ?????????????????????????????
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=

# ?? Cursor ACP (optional ù can also be saved as a Secret in the UI) ???????????
# Required inside Docker when using the Cursor agent preset (`agent acp`).
# ACP only advertises cursor_login (browser/`agent login`); without a key that
# call hangs headless. Generate at https://cursor.com/dashboard ? Integrations.
# CURSOR_API_KEY=
# CURSOR_AUTH_TOKEN=
# CURSOR_API_ENDPOINT=https://api2.cursor.sh

# ?? OpenCode ACP (optional ù can also be saved as a Secret in the UI) ?????????
# Used inside Docker when using the OpenCode agent preset (`opencode acp`).
# Locally, `opencode auth login` is reused automatically when available.
# OPENCODE_API_KEY=

# VITE_DO_NOT_TRACK=1

# -- Pentest all-in-one (PROJETOSIN-200) ù required for docker compose up ------
# Fragments are included from docker-compose.yml. Compose fails interpolation
# if these are missing. Generate locally; never commit real values.
# Do not use SESSION_API_KEY=dev-session-key (forbidden unless
# PENTEST_ALLOW_DEV_SESSION_KEY=1).
# SESSION_API_KEY=
# FINDINGS_DB_PASSWORD=
# ENGMGR_DB_PASSWORD=
# DEFAULT_PENTEST_PROFILE=pentester
# FINDINGS_UPSTREAM=http://findings-service:8000
# ENGMGR_UPSTREAM=http://engagement-manager:8000

# -- Pentest Findings / DefectDojo (Heimdall production mirror ù do not provision new DD)
# FINDINGS_SERVICE_URL=http://findings-service:8000

# -- Android emulator (budtmo/docker-android) ù opt-in profile ---------------
# https://github.com/budtmo/docker-android
# COMPOSE_PROFILES=android-emulator
# ANDROID_EMULATOR_IMAGE=budtmo/docker-android:emulator_13.0
# ANDROID_EMULATOR_DEVICE=Samsung Galaxy S10
# ANDROID_EMULATOR_WEB_VNC=true
# ANDROID_EMULATOR_ACCEL=false
# ANDROID_ADB_HOST_PORT=5555
# ANDROID_NOVNC_HOST_PORT=6080
# ADB_HOST=android-emulator
# ADB_PORT=5555
# PENTEST_ADB_TARGET=emulator
# EMULATOR_NOVNC_URL=http://android-emulator:6080

# -- Offensive runtimes (web / network / sast) ó opt-in profile ----------------
# COMPOSE_PROFILES=android-emulator,pentest-runtimes
# RUNTIME_WEB_IMAGE=heimdall/runtime-web:local
# RUNTIME_NETWORK_IMAGE=heimdall/runtime-network:local
# RUNTIME_SAST_IMAGE=heimdall/runtime-sast:local
# RUNTIME_WEB_HEALTHZ_HOST_PORT=8090
# RUNTIME_WEB_ZAP_HOST_PORT=18080
# RUNTIME_NETWORK_HEALTHZ_HOST_PORT=8091
# RUNTIME_SAST_HEALTHZ_HOST_PORT=8094
# MSF_RPC_HOST_PORT=55553
# MSF_PASSWORD=
# ZAP_URL=http://runtime-web:8080
# RUNTIME_WEB_URL=http://runtime-web:8090
# RUNTIME_NETWORK_URL=http://runtime-network:8091
# RUNTIME_SAST_URL=http://runtime-sast:8094
# MSF_RPC_HOST=runtime-network
# MSF_RPC_PORT=55553
# DEFECTDOJO_API_URL=https://defectdojo.heimdallsec.example
# DEFECTDOJO_API_TOKEN=
# DEFECTDOJO_PRODUCT_TYPE_DEFAULT=Pentest
# DEFECTDOJO_VERIFY_TLS=true
